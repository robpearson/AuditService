name = "Delete & Re-create Application"
cancel_queued_tasks = true
cancel_running_tasks = true
default_guided_failure_mode = "EnvironmentDefault"
description = "Tears down and re-registers the ArgoCD Application definition. Useful for recovering from a corrupted or misconfigured Application resource."

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {}