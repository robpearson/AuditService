name = "Restart Application Pods"
cancel_queued_tasks = true
cancel_running_tasks = true
default_guided_failure_mode = "EnvironmentDefault"
description = "Triggers a rolling restart of the workloads managed by the ArgoCD Application, for when a fresh pod cycle is needed without a full redeploy."

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {}