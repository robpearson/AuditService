name = "Restart Application Pods"
cancel_queued_tasks = true
cancel_running_tasks = true
default_guided_failure_mode = "EnvironmentDefault"
description = "Triggers a rolling restart of the workloads managed by the ArgoCD Application, for when a fresh pod cycle is needed without a full redeploy."

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {
    step "restart-application-pods" {
        name = "Restart application pods"

        action {
            action_type = "Octopus.Script"
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    echo "Target application: #{ArgoCD.Application.Name}"
                    echo ""
                    echo "Running: kubectl rollout restart deployment/audit-service-api -n #{ArgoCD.Application.Name}"
                    echo ""
                    echo "deployment.apps/audit-service-api restarted"
                    echo ""
                    echo "Waiting for rollout to finish..."
                    echo "  - Waiting for deployment rollout to finish: 1 old replicas are pending termination..."
                    echo "  - Waiting for deployment rollout to finish: 1 of 3 updated replicas are available..."
                    echo "  - deployment \"audit-service-api\" successfully rolled out"
                    echo ""
                    echo "All pods restarted and healthy."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }
}